{
  "name": "web-app-template",
  "private": true,
  "version": "0.1.0",
  "description": "A starting point for small offline web apps: TypeScript, Vite, i18n, PWA, TDD.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
